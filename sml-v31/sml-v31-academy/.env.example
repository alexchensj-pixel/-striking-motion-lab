# MI SML · autenticación (Auth0) y API privada. Copiar a .env.local para desarrollo; en producción, definir en
# Netlify → Site configuration → Environment variables. NUNCA subir .env.local al repositorio.

# ── FRONTEND (prefijo VITE_: se incluyen en el JavaScript del navegador → solo valores PÚBLICOS, nunca secretos) ──
# Sin DOMAIN y CLIENT_ID, /mi-sml muestra «El acceso de clientes todavía no está activo».
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Identificador de la API privada de MI SML registrada en Auth0 (Applications → APIs). Necesario para llamar a /api/mi-sml/me.
VITE_AUTH0_AUDIENCE=

# ── SERVIDOR (SIN prefijo VITE_: solo las lee la función de Netlify y el servidor de desarrollo; no llegan al navegador) ──
# Deben coincidir con los de arriba: AUTH0_DOMAIN = VITE_AUTH0_DOMAIN y AUTH0_AUDIENCE = VITE_AUTH0_AUDIENCE.
# No son secretos (la API valida los tokens con las claves PÚBLICAS de Auth0), pero se leen solo en servidor.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# PASO 4 (no existe todavía): aquí irán las credenciales de Airtable, SIEMPRE como variables de servidor sin prefijo VITE_.

# ── AIRTABLE (SERVIDOR; NUNCA VITE_) ──
AIRTABLE_BASE_ID=appNrxsvRyTYBYHlC
AIRTABLE_TOKEN=
# Campo de Contactos que contiene el `sub` de Auth0. Debe existir en Airtable.
AIRTABLE_AUTH0_FIELD=Auth0 ID
# Auth0 sub del usuario administrador de MI SML (solo servidor / Netlify, nunca VITE_)
ADMIN_AUTH0_SUB=

# Generación de rutinas con IA (solo servidor; nunca usar prefijo VITE_).
# Si no se configura OPENAI_API_KEY, el dashboard muestra que el generador no está disponible.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
